<?xml version="1.0" encoding="UTF-8"?>
<!--
  The app writes HKCU\...\Run\ClaudeCron when the user toggles "start with
  Windows" in the tray. Tauri's stock MSI doesn't know about that key, so an
  uninstall used to leave a dead Run entry pointing at the removed exe. This
  fragment schedules the value for removal on uninstall regardless of whether
  the installer ever wrote it.

  The marker RegistryValue is the component's KeyPath so MSI is happy with an
  HKCU-only component; it lives under HKCU\Software\WindowCrontab\Cleanup and
  is harmless if left behind.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Component Id="CleanupAutostartRegistry" Guid="*">
        <RegistryValue
          Root="HKCU"
          Key="Software\WindowCrontab\Cleanup"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes"/>
        <RemoveRegistryValue
          Root="HKCU"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="ClaudeCron"
          Action="removeOnUninstall"/>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
